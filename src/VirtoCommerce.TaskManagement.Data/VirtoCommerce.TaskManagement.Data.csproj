<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Project is not a test project -->
    <SonarQubeTestProject>false</SonarQubeTestProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\VirtoCommerce.TaskManagement.Core\VirtoCommerce.TaskManagement.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="VirtoCommerce.Platform.Data" Version="3.1025.0" />
    <PackageReference Include="VirtoCommerce.Platform.Hangfire" Version="3.1025.0" />
    <PackageReference Include="VirtoCommerce.Platform.Security" Version="3.1025.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Transitive override: MySqlConnector otherwise resolves to 1.0.0 here (via Platform.Hangfire) and to 2.5.0 in Data.MySql (via Platform.Data.MySql), -->
    <!-- both vulnerable (GHSA-473q-m89c-ghf8); every project that resolves it references this one. Remove once the module no longer references -->
    <!-- Platform.Hangfire and is on platform 3.1091.0 or later, which pins MySqlConnector 2.6.2. -->
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
  </ItemGroup>
</Project>
